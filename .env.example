# eduquery — пример конфигурации. Скопируй в .env и поправь.

# Порт, на котором панель будет доступна снаружи.
WEB_PORT=8080

# Логин администратора.
EDUQUERY_ADMIN_USER=admin
EDUQUERY_ADMIN_PASS=change-me

# Потоки CPU для инференса. 0 = авто (по числу ядер).
EDUQUERY_N_THREADS=0

# Размер контекста модели в токенах. Больше — меньше обрезка длинных отчётов,
# но выше расход памяти.
EDUQUERY_N_CTX=4096

# Разрешить скачивание GGUF-моделей из интернета через веб-интерфейс.
EDUQUERY_ALLOW_REMOTE_DOWNLOAD=true

# Вход без пароля (НЕБЕЗОПАСНО, только для локальной отладки).
EDUQUERY_ALLOW_ANONYMOUS=false

# Лимит памяти контейнера.
EDUQUERY_MEMORY_LIMIT=8g

# Уровень логирования.
RUST_LOG=eduquery=info,warn

# Вариант движка llama.cpp: пусто = CPU, vulkan = GPU через Vulkan.
EDUQUERY_ENGINE_VARIANT=

# MTU docker-сети. Поставьте MTU вашего хоста, если он меньше 1500 (VPN/PPPoE).
EDUQUERY_MTU=1500
